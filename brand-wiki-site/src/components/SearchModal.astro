---
import { getCollection } from 'astro:content';
import { categoryLabel, orderDocs } from '../data/wiki';

const docs = orderDocs(await getCollection('docs'));
const searchDocs = docs.map((doc) => ({
  title: doc.data.title,
  slug: `/docs/${doc.slug}`,
  description: doc.data.description ?? '',
  category: categoryLabel(doc.data.category),
}));
---

<div class="search-overlay" id="search-overlay" role="dialog" aria-modal="true" aria-labelledby="search-heading" aria-hidden="true">
  <div class="search-modal">
    <div class="search-modal__header">
      <div>
        <p class="search-modal__eyebrow">Archive search</p>
        <h2 class="search-modal__title" id="search-heading">Find a dossier fast</h2>
      </div>
      <button type="button" class="search-close" id="search-close" aria-label="Close archive search">
        <span></span>
        <span></span>
      </button>
    </div>

    <div class="search-input-wrapper">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20l-3.2-3.2"></path>
      </svg>
      <input type="text" class="search-input" id="search-input" placeholder="Search topics, categories, or dossiers" autocomplete="off" />
      <kbd class="search-kbd">ESC</kbd>
    </div>

    <div class="search-results" id="search-results"></div>
  </div>
</div>

<script type="application/json" id="doc-search-data" set:html={JSON.stringify(searchDocs)}></script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: start center;
    padding: 9vh 1rem 1rem;
    background: rgba(9, 8, 6, 0.7);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    z-index: 120;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-fast) var(--ease-out-quart), visibility var(--duration-fast) var(--ease-out-quart);
  }

  .search-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .search-modal {
    width: min(100%, 54rem);
    border: 1px solid var(--color-border-strong);
    border-radius: 1.75rem;
    background: var(--surface-panel-strong);
    box-shadow: var(--shadow-panel-strong);
    transform: translateY(10px) scale(0.985);
    transition: transform var(--duration-fast) var(--ease-out-expo);
    overflow: hidden;
  }

  .search-overlay.open .search-modal {
    transform: translateY(0) scale(1);
  }

  .search-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 1.5rem 1rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .search-modal__eyebrow {
    font-family: var(--font-sans);
    color: var(--color-text-tertiary);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .search-modal__title {
    margin-top: 0.15rem;
    font-size: 1.65rem;
  }

  .search-close {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-primary);
    cursor: pointer;
    position: relative;
    transition: background var(--duration-fast) var(--ease-out-quart), border-color var(--duration-fast) var(--ease-out-quart), transform var(--duration-fast) var(--ease-out-quart);
  }

  .search-close:hover {
    background: var(--surface-panel-soft);
    border-color: var(--color-accent-muted);
    transform: translateY(-1px);
  }

  .search-close span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.9rem;
    height: 1px;
    background: currentColor;
  }

  .search-close span:first-child {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .search-close span:last-child {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--color-divider);
    color: var(--color-text-tertiary);
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: 1rem;
  }

  .search-input::placeholder {
    color: var(--color-text-tertiary);
  }

  .search-kbd {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 999px;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .search-results {
    max-height: min(60vh, 34rem);
    overflow: auto;
    padding: 0.65rem;
    display: grid;
    gap: 0.35rem;
  }

  .search-result {
    display: grid;
    gap: 0.22rem;
    padding: 0.95rem 1rem;
    border: 1px solid transparent;
    border-radius: 1rem;
    color: var(--color-text-primary);
    text-decoration: none;
    background: transparent;
    transition: border-color var(--duration-fast) var(--ease-out-quart), background var(--duration-fast) var(--ease-out-quart), transform var(--duration-fast) var(--ease-out-quart);
  }

  .search-result:hover,
  .search-result:focus-visible {
    background: var(--surface-panel-soft);
    border-color: var(--color-border-soft);
    transform: translateY(-1px);
    outline: none;
  }

  .search-result__meta {
    font-family: var(--font-sans);
    color: var(--color-text-tertiary);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .search-result__title {
    font-size: 0.97rem;
    line-height: 1.45;
  }

  .search-result__description {
    color: var(--color-text-secondary);
    font-size: 0.79rem;
    line-height: 1.55;
  }

  .search-results__empty {
    padding: 1rem;
    color: var(--color-text-secondary);
    font-size: 0.88rem;
  }
</style>

<script is:inline>
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const closeButton = document.getElementById('search-close');
  const dataNode = document.getElementById('doc-search-data');
  const searchData = JSON.parse(dataNode.textContent || '[]');

  const escapeHtml = (value) => value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');

  const renderResults = (query = '') => {
    const normalized = query.trim().toLowerCase();
    const matches = normalized
      ? searchData.filter((doc) => [doc.title, doc.description, doc.category].join(' ').toLowerCase().includes(normalized))
      : searchData;

    if (!matches.length) {
      results.innerHTML = '<p class="search-results__empty">No matching dossier yet. Try a broader term.</p>';
      return;
    }

    results.innerHTML = matches
      .slice(0, 12)
      .map((doc) => `
        <a class="search-result" href="${doc.slug}">
          <span class="search-result__meta">${escapeHtml(doc.category)}</span>
          <span class="search-result__title">${escapeHtml(doc.title)}</span>
          <span class="search-result__description">${escapeHtml(doc.description)}</span>
        </a>
      `)
      .join('');
  };

  const openSearch = () => {
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    renderResults(input.value);
    requestAnimationFrame(() => input.focus());
  };

  const closeSearch = () => {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
  };

  window.openArchiveSearch = openSearch;

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      if (overlay.classList.contains('open')) {
        closeSearch();
      } else {
        openSearch();
      }
    }

    if (event.key === 'Escape' && overlay.classList.contains('open')) {
      closeSearch();
    }
  });

  document.querySelectorAll('[data-search-trigger]').forEach((element) => {
    element.addEventListener('click', () => openSearch());
  });

  input.addEventListener('input', (event) => renderResults(event.target.value));
  closeButton.addEventListener('click', closeSearch);

  overlay.addEventListener('click', (event) => {
    if (event.target === overlay) {
      closeSearch();
    }
  });

  renderResults();
</script>
