---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  archiveStats,
  assetFamilyMeta,
  assetFamilyOrder,
  brandmintRunStats,
  categoryMeta,
  categoryOrder,
  orderDocs,
  primaryReadingPath,
} from '../data/wiki';

const docs = orderDocs(await getCollection('docs'));
const docsBySlug = new Map(docs.map((doc) => [doc.slug, doc]));
const readingPath = primaryReadingPath
  .map((slug) => docsBySlug.get(slug))
  .filter(Boolean);

const heroPillars = [
  {
    title: 'High rigor',
    body: 'PubMed-grade neuroscience and trauma biology, not vague mystic shorthand.',
  },
  {
    title: 'High embodiment',
    body: 'The body stays central: vagal tone, cardiac coherence, and lived somatic experience.',
  },
  {
    title: 'Transformational arc',
    body: 'A three-book progression from diagnosis to integration to liberation.',
  },
] as const;

const categories = categoryOrder
  .map((category) => ({
    meta: categoryMeta[category],
    docs: docs.filter((doc) => (doc.data.category ?? 'overview') === category),
  }))
  .filter((group) => group.docs.length > 0);

const assetFamilies = assetFamilyOrder.map((family) => ({
  meta: assetFamilyMeta[family],
  docs: assetFamilyMeta[family].relatedDocs.map((slug) => docsBySlug.get(slug)).filter(Boolean),
}));

const featuredDocs = docs.slice(0, 3);
---
<BaseLayout
  title="Somatic Canticles Brand Archive"
  description="An editorial archive for the Somatic Canticles trilogy spanning brand strategy, reader positioning, market proof, and the full visual system."
>
  <div class="home-page">
    <section class="home-hero rich-card rich-card--hero">
      <div class="home-hero__copy">
        <p class="kicker">Editorial archive</p>
        <h1>Where clinical mysticism gets documented with actual precision.</h1>
        <p class="home-hero__body">
          This wiki is the operating archive for Somatic Canticles: trilogy architecture, voice doctrine,
          visual identity, audience strategy, and market proof arranged as a readable editorial system rather
          than a pile of disconnected notes.
        </p>

        <div class="home-hero__pillars">
          {heroPillars.map((pillar) => (
            <article class="rich-card home-hero__pillar">
              <span>{pillar.title}</span>
              <p>{pillar.body}</p>
            </article>
          ))}
        </div>

        <div class="home-hero__actions">
          <a href="/docs/index" class="button button--primary">Start with the brief</a>
          <a href="#asset-flow" class="button button--secondary">Follow the Brandmint asset flow</a>
          <button type="button" class="button button--ghost" data-search-trigger>Search dossiers</button>
        </div>

        <div class="home-stats">
          {archiveStats.map((stat) => (
            <article class="rich-card home-stats__card">
              <span class="home-stats__value">{stat.value}</span>
              <span class="home-stats__label">{stat.label}</span>
            </article>
          ))}
        </div>
      </div>

      <div class="home-hero__media">
        <figure class="image-frame image-frame--portrait home-hero__figure home-hero__figure--cover">
          <img
            src={categoryMeta.product.featureImage.src}
            width={categoryMeta.product.featureImage.width}
            height={categoryMeta.product.featureImage.height}
            alt={categoryMeta.product.featureAlt}
            loading="eager"
          />
          <figcaption>Primary trilogy cover system</figcaption>
        </figure>

        <figure class="image-frame image-frame--wide home-hero__figure home-hero__figure--board">
          <img
            src={categoryMeta.overview.featureImage.src}
            width={categoryMeta.overview.featureImage.width}
            height={categoryMeta.overview.featureImage.height}
            alt={categoryMeta.overview.featureAlt}
            loading="eager"
          />
          <figcaption>Brand board spanning covers, logos, and symbolic anatomy</figcaption>
        </figure>
      </div>
    </section>

    <section class="section-block" id="asset-flow">
      <div class="section-heading">
        <p class="section-heading__eyebrow">Asset flow</p>
        <h2>The visual system now follows the Brandmint handoff</h2>
        <p>
          The archive no longer treats imagery as a side appendix or a hand-sorted gallery. Covers, logos, anatomy,
          arcana, and the consolidated brand board are mapped from the current Brandmint run
          ({brandmintRunStats.totalAssets} assets, {brandmintRunStats.totalApiCalls} calls) and tied back to the
          dossiers that explain them.
        </p>
      </div>

      <div class="asset-flow">
        {assetFamilies.map(({ meta, docs: familyDocs }) => (
          <article class="rich-card asset-flow__card">
            <figure class="image-frame image-frame--wide asset-flow__media">
              <img
                src={meta.featureImage.src}
                width={meta.featureImage.width}
                height={meta.featureImage.height}
                alt={meta.featureAlt}
                loading="lazy"
              />
              <figcaption>{meta.featureAlt}</figcaption>
            </figure>

            <div class="asset-flow__content">
              <div class="asset-flow__head">
                <span class="section-heading__eyebrow">{meta.count} assets</span>
                <h3>{meta.label}</h3>
              </div>
              <p>{meta.description}</p>

              <div class="asset-flow__links">
                <a href={meta.href} class="button button--secondary">Open in atlas</a>
                <div class="asset-flow__docs">
                  {familyDocs.map((doc) => (
                    <a href={`/docs/${doc.slug}`}>{doc.data.title}</a>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="section-heading__eyebrow">Recommended sequence</p>
        <h2>Read the archive in five moves</h2>
        <p>
          The shortest path from orientation to proof: what the trilogy is, how it should look, who it serves,
          and why the market case is real.
        </p>
      </div>

      <div class="reading-path">
        {readingPath.map((doc, index) => (
          <a href={`/docs/${doc.slug}`} class="rich-card reading-path__card">
            <span class="reading-path__step">0{index + 1}</span>
            <strong>{doc.data.title}</strong>
            {doc.data.description && <p>{doc.data.description}</p>}
          </a>
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <p class="section-heading__eyebrow">Archive map</p>
        <h2>Five sections, one coherent thesis</h2>
        <p>
          Every section uses the real Somatic Canticles assets instead of placeholders: covers, logos, anatomy,
          arcana studies, and the consolidated brand board.
        </p>
      </div>

      <div class="category-shelf">
        {categories.map(({ meta, docs: sectionDocs }) => (
          <article class="rich-card category-card">
            <div class="category-card__content">
              <p class="section-heading__eyebrow">{meta.kicker}</p>
              <h3>{meta.label}</h3>
              <p>{meta.description}</p>
              <ul>
                {sectionDocs.slice(0, 3).map((doc) => (
                  <li>
                    <a href={`/docs/${doc.slug}`}>{doc.data.title}</a>
                  </li>
                ))}
              </ul>
            </div>

            <figure class="category-card__media image-frame">
              <img
                src={meta.featureImage.src}
                width={meta.featureImage.width}
                height={meta.featureImage.height}
                alt={meta.featureAlt}
                loading="lazy"
              />
              <figcaption>{meta.featureAlt}</figcaption>
            </figure>
          </article>
        ))}
      </div>
    </section>

    <section class="section-block home-featured">
      <div class="section-heading">
        <p class="section-heading__eyebrow">Featured dossiers</p>
        <h2>High-signal entries worth opening first</h2>
      </div>

      <div class="home-featured__grid">
        {featuredDocs.map((doc) => (
          <a href={`/docs/${doc.slug}`} class="rich-card home-featured__card">
            <span class="section-heading__eyebrow">{doc.data.category ?? 'Archive'}</span>
            <strong>{doc.data.title}</strong>
            {doc.data.description && <p>{doc.data.description}</p>}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-page {
    display: grid;
    gap: 2rem;
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 28rem);
    gap: 1.5rem;
    align-items: stretch;
  }

  .home-hero__copy {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .home-hero__copy h1 {
    max-width: 11ch;
    font-size: clamp(3rem, 6vw, 5.3rem);
    line-height: 0.92;
  }

  .home-hero__body {
    max-width: 42rem;
    font-size: 1.08rem;
    line-height: 1.82;
    color: var(--color-text-secondary);
  }

  .home-hero__pillars {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .home-hero__pillar {
    display: grid;
    gap: 0.5rem;
    min-height: 100%;
    grid-column: span 3;
  }

  .home-hero__pillar:last-child {
    grid-column: span 6;
  }

  .home-hero__pillar span {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .home-hero__pillar p {
    color: var(--color-text-secondary);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .home-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .home-stats__card {
    display: grid;
    gap: 0.2rem;
  }

  .home-stats__value {
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 650;
  }

  .home-stats__label {
    font-family: var(--font-sans);
    color: var(--color-text-tertiary);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-hero__media {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .home-hero__figure {
    height: 100%;
  }

  .home-hero__figure--cover img {
    aspect-ratio: 5 / 6;
  }

  .home-hero__figure--board img {
    aspect-ratio: 16 / 10;
  }

  .asset-flow {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .asset-flow__card {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .asset-flow__content {
    display: grid;
    gap: 0.75rem;
  }

  .asset-flow__head {
    display: grid;
    gap: 0.3rem;
  }

  .asset-flow__head h3 {
    font-size: 1.45rem;
    line-height: 1.05;
  }

  .asset-flow__content p {
    color: var(--color-text-secondary);
  }

  .asset-flow__links {
    display: grid;
    gap: 0.85rem;
  }

  .asset-flow__docs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .asset-flow__docs a {
    color: var(--color-text-primary);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .reading-path {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .reading-path__card {
    display: grid;
    gap: 0.75rem;
    min-height: 100%;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .reading-path__step {
    font-family: var(--font-sans);
    color: var(--color-accent);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .reading-path__card p,
  .category-card__content p,
  .home-featured__card p {
    color: var(--color-text-secondary);
  }

  .category-shelf {
    display: grid;
    gap: 1rem;
  }

  .category-card {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(15rem, 19rem);
    gap: 1rem;
    align-items: center;
  }

  .category-card__content {
    display: grid;
    gap: 0.8rem;
  }

  .category-card__content h3 {
    font-size: 1.55rem;
    line-height: 1.05;
  }

  .category-card__content ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-left: 1.1rem;
  }

  .category-card__content a {
    color: var(--color-text-primary);
  }

  .home-featured__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .home-featured__card {
    display: grid;
    gap: 0.75rem;
    min-height: 100%;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  @media (max-width: 1200px) {
    .reading-path {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .home-hero,
    .category-card,
    .asset-flow {
      grid-template-columns: 1fr;
    }

    .reading-path,
    .home-featured__grid,
    .home-stats {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .home-hero__pillars {
      grid-template-columns: 1fr;
    }

    .home-hero__pillar,
    .home-hero__pillar:last-child {
      grid-column: span 1;
    }

    .reading-path {
      display: flex;
      gap: 0.9rem;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      scroll-snap-type: x proximity;
    }

    .reading-path__card {
      min-width: min(18rem, 82vw);
      scroll-snap-align: start;
    }
  }
</style>
