---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  assetFamilyMeta,
  assetFamilyOrder,
  brandmintRunStats,
  getAssetFamilyAssets,
  orderDocs,
} from '../data/wiki';

const docs = orderDocs(await getCollection('docs'));
const docsBySlug = new Map(docs.map((doc) => [doc.slug, doc]));

const grouped = assetFamilyOrder
  .map((family) => ({
    meta: assetFamilyMeta[family],
    items: getAssetFamilyAssets(family),
    docs: assetFamilyMeta[family].relatedDocs.map((slug) => docsBySlug.get(slug)).filter(Boolean),
  }))
  .filter((group) => group.items.length > 0);

const totalAssets = grouped.reduce((sum, group) => sum + group.items.length, 0);
---
<BaseLayout
  title="Somatic Canticles Visual Atlas"
  description="The Brandmint-backed visual library for the Somatic Canticles wiki, grouped by covers, logos, anatomy, arcana, and the consolidated brand kit."
>
  <div class="atlas-page">
    <section class="atlas-hero rich-card rich-card--hero">
      <div class="atlas-hero__copy">
        <p class="kicker">Visual atlas</p>
        <h1>The current Brandmint run, mapped into the archive flow.</h1>
        <p>
          Every family on this page is assembled from the Brandmint generation manifest and the synced media manifest,
          then routed back into the dossiers that explain what the visuals are doing. This is the pipeline handoff
          layer, not a generic image dump.
        </p>
        <div class="atlas-hero__meta">
          <span class="stat-chip">{totalAssets} total assets</span>
          <span class="stat-chip">{brandmintRunStats.totalApiCalls} API calls</span>
          <span class="stat-chip">${brandmintRunStats.estimatedCostUsd} estimated run cost</span>
          <span class="stat-chip">Brandmint manifest-backed</span>
        </div>
      </div>

      <div class="atlas-hero__jump-grid">
        {grouped.map((group) => (
          <a href={`#${group.meta.id}`} class="atlas-jump-card">
            <span class="atlas-jump-card__count">{group.items.length} assets</span>
            <strong>{group.meta.label}</strong>
            <span>{group.meta.kicker}</span>
          </a>
        ))}
      </div>
    </section>

    {grouped.map((group) => (
      <section id={group.meta.id} class="section-block atlas-section">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{group.items.length} assets · {group.meta.kicker}</p>
          <h2>{group.meta.label}</h2>
          <p>{group.meta.description}</p>
        </div>

        <div class="atlas-section__context rich-card">
          <figure class="image-frame image-frame--wide atlas-section__hero-image">
            <img
              src={group.meta.featureImage.src}
              width={group.meta.featureImage.width}
              height={group.meta.featureImage.height}
              alt={group.meta.featureAlt}
              loading="lazy"
            />
            <figcaption>{group.meta.featureAlt}</figcaption>
          </figure>

          <div class="atlas-section__entrypoints">
            <p class="section-heading__eyebrow">Entry dossiers</p>
            <div class="atlas-section__entrypoint-grid">
              {group.docs.map((doc) => (
                <a href={`/docs/${doc.slug}`} class="atlas-entry-card">
                  <strong>{doc.data.title}</strong>
                  {doc.data.description && <span>{doc.data.description}</span>}
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="atlas-grid">
          {group.items.map((item) => (
            <figure class="rich-card atlas-card">
              <div class:list={['atlas-card__media', `atlas-card__media--${item.orientation}`]}>
                <img
                  src={item.image.src}
                  width={item.image.width}
                  height={item.image.height}
                  alt={item.alt}
                  loading="lazy"
                />
              </div>
              <figcaption>
                <span class="atlas-card__id">{item.id}</span>
                <strong>{item.title}</strong>
                <span class="atlas-card__subtitle">{item.subtitle}</span>
                <span class="atlas-card__filename">{item.fileName}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .atlas-page {
    display: grid;
    gap: 2rem;
  }

  .atlas-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 26rem);
    gap: 1rem;
    align-items: start;
  }

  .atlas-hero__copy {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .atlas-hero__copy h1 {
    max-width: 12ch;
    font-size: clamp(2.8rem, 5.4vw, 4.8rem);
    line-height: 0.95;
  }

  .atlas-hero__copy p:last-of-type {
    color: var(--color-text-secondary);
    font-size: 1.04rem;
    line-height: 1.82;
  }

  .atlas-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .atlas-hero__jump-grid {
    display: grid;
    gap: 0.75rem;
  }

  .atlas-jump-card {
    display: grid;
    gap: 0.18rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 1rem;
    background: var(--surface-panel-soft);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out-quart), transform var(--duration-fast) var(--ease-out-quart), background var(--duration-fast) var(--ease-out-quart);
  }

  .atlas-jump-card:hover {
    transform: translateY(-1px);
    border-color: var(--color-accent-muted);
    background: var(--surface-panel-strong);
  }

  .atlas-jump-card__count,
  .atlas-jump-card span:last-child {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .atlas-jump-card__count {
    color: var(--color-accent);
  }

  .atlas-jump-card span:last-child {
    color: var(--color-text-tertiary);
  }

  .atlas-section {
    scroll-margin-top: 6rem;
  }

  .atlas-section__context {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
    gap: 1rem;
    align-items: start;
  }

  .atlas-section__entrypoints {
    display: grid;
    gap: 0.75rem;
  }

  .atlas-section__entrypoint-grid {
    display: grid;
    gap: 0.75rem;
  }

  .atlas-entry-card {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 1rem;
    color: var(--color-text-primary);
    text-decoration: none;
    background: color-mix(in srgb, var(--surface-panel-soft) 94%, transparent);
    transition: border-color var(--duration-fast) var(--ease-out-quart), transform var(--duration-fast) var(--ease-out-quart), background var(--duration-fast) var(--ease-out-quart);
  }

  .atlas-entry-card:hover {
    transform: translateY(-1px);
    border-color: var(--color-accent-muted);
    background: var(--surface-panel-strong);
  }

  .atlas-entry-card span {
    color: var(--color-text-secondary);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .atlas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .atlas-card {
    display: grid;
    gap: 0.8rem;
    padding: 0.9rem;
  }

  .atlas-card__media {
    display: grid;
    place-items: center;
    padding: 0.85rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border-soft);
    background:
      radial-gradient(circle at top, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 62%),
      linear-gradient(180deg, color-mix(in srgb, var(--surface-panel-strong) 78%, transparent), color-mix(in srgb, var(--surface-panel-soft) 96%, transparent));
    overflow: hidden;
  }

  .atlas-card__media--portrait {
    min-height: 26rem;
  }

  .atlas-card__media--landscape {
    min-height: 14rem;
  }

  .atlas-card__media--square {
    min-height: 18rem;
  }

  .atlas-card__media img {
    width: 100%;
    height: auto;
    max-height: 25rem;
    object-fit: contain;
  }

  .atlas-card figcaption {
    display: grid;
    gap: 0.24rem;
  }

  .atlas-card__id,
  .atlas-card__filename {
    color: var(--color-text-tertiary);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .atlas-card__id {
    color: var(--color-accent);
  }

  .atlas-card__subtitle {
    color: var(--color-text-secondary);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .atlas-card strong {
    font-size: 0.95rem;
  }

  @media (max-width: 960px) {
    .atlas-hero,
    .atlas-section__context {
      grid-template-columns: 1fr;
    }
  }
</style>
