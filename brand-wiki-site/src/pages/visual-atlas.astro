---
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../images/**/*.{webp,png,jpg,jpeg,avif}',
  { eager: true }
);

const labelMap: Record<string, string> = {
  'brand-kit': 'Brand Kit',
  covers: 'Book Covers',
  logos: 'Logo System',
  anatomy: 'Anatomy Diagrams',
  arcana: 'Arcana Studies',
};

const order = ['brand-kit', 'covers', 'logos', 'anatomy', 'arcana'];

const atlas = Object.entries(imageModules)
  .map(([path, module]) => {
    const image = module.default;
    const parts = path.split('/');
    const category = parts.at(-2) ?? 'misc';
    const filename = (parts.at(-1) ?? '').replace(/\.[^.]+$/, '');
    const title = filename
      .split('-')
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(' ');

    return {
      category,
      filename,
      title,
      alt: filename.replaceAll('-', ' '),
      image,
    };
  })
  .filter((entry) => entry.filename !== 'README');

const grouped = order
  .map((category) => ({
    category,
    label: labelMap[category] ?? category,
    items: atlas.filter((entry) => entry.category === category),
  }))
  .filter((group) => group.items.length > 0);

const totalAssets = atlas.length;
---
<BaseLayout
  title="Somatic Canticles Visual Atlas"
  description="The full mapped visual library for the Somatic Canticles wiki, grouped by covers, logos, anatomy, arcana, and the consolidated brand kit."
>
  <div class="atlas-page">
    <section class="atlas-hero rich-card rich-card--hero">
      <div class="atlas-hero__copy">
        <p class="kicker">Visual atlas</p>
        <h1>The full mapped asset library behind the archive.</h1>
        <p>
          Every image used across the wiki is sourced from the mapped Somatic Canticles asset sets. This atlas keeps
          the identity system inspectable instead of hiding the visual logic behind isolated page layouts.
        </p>
        <div class="atlas-hero__meta">
          <span class="stat-chip">{totalAssets} total assets</span>
          <span class="stat-chip">5 organized groups</span>
          <span class="stat-chip">Source-mapped from project visuals</span>
        </div>
      </div>
    </section>

    {grouped.map((group) => (
      <section class="section-block atlas-section">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{group.items.length} assets</p>
          <h2>{group.label}</h2>
        </div>

        <div class="atlas-grid">
          {group.items.map((item) => (
            <figure class="rich-card atlas-card">
              <img
                src={item.image.src}
                width={item.image.width}
                height={item.image.height}
                alt={item.alt}
                loading="lazy"
              />
              <figcaption>
                <strong>{item.title}</strong>
                <span>{item.filename}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .atlas-page {
    display: grid;
    gap: 2rem;
  }

  .atlas-hero {
    display: grid;
    gap: 1rem;
  }

  .atlas-hero__copy {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .atlas-hero__copy h1 {
    max-width: 12ch;
    font-size: clamp(2.8rem, 5.4vw, 4.8rem);
    line-height: 0.95;
  }

  .atlas-hero__copy p:last-of-type {
    color: var(--color-text-secondary);
    font-size: 1.04rem;
    line-height: 1.82;
  }

  .atlas-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .atlas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .atlas-card {
    display: grid;
    gap: 0.8rem;
    padding: 0.9rem;
  }

  .atlas-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 1rem;
    border: 1px solid var(--color-border-soft);
  }

  .atlas-card figcaption {
    display: grid;
    gap: 0.2rem;
  }

  .atlas-card strong {
    font-size: 0.95rem;
  }

  .atlas-card span {
    color: var(--color-text-tertiary);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
