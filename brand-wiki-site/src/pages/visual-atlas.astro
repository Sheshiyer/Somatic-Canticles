---
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { assetFamilyMeta, assetFamilyOrder, orderDocs } from '../data/wiki';

const docs = orderDocs(await getCollection('docs'));
const docsBySlug = new Map(docs.map((doc) => [doc.slug, doc]));

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../images/**/*.{webp,png,jpg,jpeg,avif}',
  { eager: true }
);

const atlas = Object.entries(imageModules)
  .map(([path, module]) => {
    const image = module.default;
    const parts = path.split('/');
    const category = parts.at(-2) ?? 'misc';
    const filename = (parts.at(-1) ?? '').replace(/\.[^.]+$/, '');
    const title = filename
      .split('-')
      .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
      .join(' ');

    return {
      category,
      filename,
      title,
      alt: filename.replaceAll('-', ' '),
      image,
    };
  })
  .filter((entry) => entry.filename !== 'README');

const grouped = assetFamilyOrder
  .map((family) => ({
    meta: assetFamilyMeta[family],
    items: atlas.filter((entry) => entry.category === family),
    docs: assetFamilyMeta[family].relatedDocs.map((slug) => docsBySlug.get(slug)).filter(Boolean),
  }))
  .filter((group) => group.items.length > 0);

const totalAssets = atlas.length;
---
<BaseLayout
  title="Somatic Canticles Visual Atlas"
  description="The full mapped visual library for the Somatic Canticles wiki, grouped by covers, logos, anatomy, arcana, and the consolidated brand kit."
>
  <div class="atlas-page">
    <section class="atlas-hero rich-card rich-card--hero">
      <div class="atlas-hero__copy">
        <p class="kicker">Visual atlas</p>
        <h1>The full mapped asset library behind the archive.</h1>
        <p>
          Every image used across the wiki is sourced from the mapped Somatic Canticles asset sets. This atlas keeps
          the identity system inspectable instead of hiding the visual logic behind isolated page layouts.
        </p>
        <div class="atlas-hero__meta">
          <span class="stat-chip">{totalAssets} total assets</span>
          <span class="stat-chip">5 organized groups</span>
          <span class="stat-chip">Source-mapped from project visuals</span>
        </div>
      </div>

      <div class="atlas-hero__jump-grid">
        {grouped.map((group) => (
          <a href={`#${group.meta.id}`} class="atlas-jump-card">
            <span class="atlas-jump-card__count">{group.items.length} assets</span>
            <strong>{group.meta.label}</strong>
            <span>{group.meta.kicker}</span>
          </a>
        ))}
      </div>
    </section>

    {grouped.map((group) => (
      <section id={group.meta.id} class="section-block atlas-section">
        <div class="section-heading">
          <p class="section-heading__eyebrow">{group.items.length} assets · {group.meta.kicker}</p>
          <h2>{group.meta.label}</h2>
          <p>{group.meta.description}</p>
        </div>

        <div class="atlas-section__context rich-card">
          <figure class="image-frame image-frame--wide atlas-section__hero-image">
            <img
              src={group.meta.featureImage.src}
              width={group.meta.featureImage.width}
              height={group.meta.featureImage.height}
              alt={group.meta.featureAlt}
              loading="lazy"
            />
            <figcaption>{group.meta.featureAlt}</figcaption>
          </figure>

          <div class="atlas-section__entrypoints">
            <p class="section-heading__eyebrow">Entry dossiers</p>
            <div class="atlas-section__entrypoint-grid">
              {group.docs.map((doc) => (
                <a href={`/docs/${doc.slug}`} class="atlas-entry-card">
                  <strong>{doc.data.title}</strong>
                  {doc.data.description && <span>{doc.data.description}</span>}
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="atlas-grid">
          {group.items.map((item) => (
            <figure class="rich-card atlas-card">
              <img
                src={item.image.src}
                width={item.image.width}
                height={item.image.height}
                alt={item.alt}
                loading="lazy"
              />
              <figcaption>
                <strong>{item.title}</strong>
                <span>{item.filename}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .atlas-page {
    display: grid;
    gap: 2rem;
  }

  .atlas-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 26rem);
    gap: 1rem;
    align-items: start;
  }

  .atlas-hero__copy {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .atlas-hero__copy h1 {
    max-width: 12ch;
    font-size: clamp(2.8rem, 5.4vw, 4.8rem);
    line-height: 0.95;
  }

  .atlas-hero__copy p:last-of-type {
    color: var(--color-text-secondary);
    font-size: 1.04rem;
    line-height: 1.82;
  }

  .atlas-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .atlas-hero__jump-grid {
    display: grid;
    gap: 0.75rem;
  }

  .atlas-jump-card {
    display: grid;
    gap: 0.18rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 1rem;
    background: var(--surface-panel-soft);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-out-quart), transform var(--duration-fast) var(--ease-out-quart), background var(--duration-fast) var(--ease-out-quart);
  }

  .atlas-jump-card:hover {
    transform: translateY(-1px);
    border-color: var(--color-accent-muted);
    background: var(--surface-panel-strong);
  }

  .atlas-jump-card__count,
  .atlas-jump-card span:last-child {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .atlas-jump-card__count {
    color: var(--color-accent);
  }

  .atlas-jump-card span:last-child {
    color: var(--color-text-tertiary);
  }

  .atlas-section {
    scroll-margin-top: 6rem;
  }

  .atlas-section__context {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
    gap: 1rem;
    align-items: start;
  }

  .atlas-section__entrypoints {
    display: grid;
    gap: 0.75rem;
  }

  .atlas-section__entrypoint-grid {
    display: grid;
    gap: 0.75rem;
  }

  .atlas-entry-card {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border-soft);
    border-radius: 1rem;
    color: var(--color-text-primary);
    text-decoration: none;
    background: color-mix(in srgb, var(--surface-panel-soft) 94%, transparent);
    transition: border-color var(--duration-fast) var(--ease-out-quart), transform var(--duration-fast) var(--ease-out-quart), background var(--duration-fast) var(--ease-out-quart);
  }

  .atlas-entry-card:hover {
    transform: translateY(-1px);
    border-color: var(--color-accent-muted);
    background: var(--surface-panel-strong);
  }

  .atlas-entry-card span {
    color: var(--color-text-secondary);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .atlas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .atlas-card {
    display: grid;
    gap: 0.8rem;
    padding: 0.9rem;
  }

  .atlas-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 1rem;
    border: 1px solid var(--color-border-soft);
  }

  .atlas-card figcaption {
    display: grid;
    gap: 0.2rem;
  }

  .atlas-card strong {
    font-size: 0.95rem;
  }

  .atlas-card span {
    color: var(--color-text-tertiary);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 960px) {
    .atlas-hero,
    .atlas-section__context {
      grid-template-columns: 1fr;
    }
  }
</style>
